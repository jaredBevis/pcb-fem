(kicad_pcb
	(version 20240108)
	(generator "pcbnew")
	(generator_version "8.0")
	(general
		(thickness 1.2)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(1 "In1.Cu" signal)
		(2 "In2.Cu" signal)
		(3 "In3.Cu" signal)
		(4 "In4.Cu" signal)
		(31 "B.Cu" signal)
		(36 "B.SilkS" user "B.Silkscreen")
		(37 "F.SilkS" user "F.Silkscreen")
		(38 "B.Mask" user)
		(39 "F.Mask" user)
		(44 "Edge.Cuts" user)
	)
	(setup
		(stackup
			(layer "F.SilkS" (type "Top Silk Screen"))
			(layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
			(layer "F.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 1" (type "prepreg") (thickness 0.075) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In1.Cu" (type "copper") (thickness 0.018))
			(layer "dielectric 2" (type "prepreg") (thickness 0.075) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In2.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 3" (type "core") (thickness 0.5) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02)
				addsublayer (thickness 0.21) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In3.Cu" (type "copper") (thickness 0.035))
			(layer "dielectric 4" (type "prepreg") (thickness 0.075) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "In4.Cu" (type "copper") (thickness 0.018))
			(layer "dielectric 5" (type "prepreg") (thickness 0.075) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
			(layer "B.Cu" (type "copper") (thickness 0.035))
			(layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
			(layer "B.SilkS" (type "Bottom Silk Screen"))
			(copper_finish "ENIG")
			(dielectric_constraints no)
		)
		(pad_to_mask_clearance 0)
	)
	(net 0 "")
	(net 1 "GND")
	(net 2 "/VBUS")
	(net 3 "SIG")

	(footprint "Test:U1" (layer "F.Cu") (at 120 105 90)
		(property "Reference" "U1" (at 0 0 90) (layer "F.SilkS"))
		(pad "1" smd roundrect (at -1 0 90) (size 0.8 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.25) (net 2 "/VBUS"))
		(pad "2" smd rect (at 1 0 90) (size 0.8 1.2) (layers "F.Cu" "F.Paste" "F.Mask") (net 3 "SIG"))
		(pad "3" smd custom (at 0 2 90) (size 0.6 0.6) (layers "F.Cu" "F.Mask") (net 1 "GND")
			(options (clearance outline) (anchor circle))
			(primitives (gr_poly (pts (xy -0.5 -0.5) (xy 0.9 -0.5) (xy 0.9 0.5) (xy -0.5 0.5)) (width 0.1) (fill yes))))
	)
	(footprint "Test:J1" (layer "F.Cu") (at 106 120)
		(property "Reference" "J1" (at 0 -2 0) (layer "F.SilkS"))
		(pad "1" thru_hole circle (at 0 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "/VBUS"))
		(pad "2" thru_hole oval (at 2.54 0) (size 1.7 2.4) (drill oval 1.0 1.6) (layers "*.Cu" "*.Mask") (remove_unused_layers yes) (keep_end_layers yes) (net 1 "GND"))
		(pad "" np_thru_hole circle (at -3 5) (size 3 3) (drill 3) (layers "*.Cu" "*.Mask"))
	)
	(footprint "Test:R1" (layer "B.Cu") (at 114 124 180)
		(property "Reference" "R1" (at 0 0 180) (layer "B.SilkS"))
		(pad "1" smd rect (at 0.8 0 180) (size 0.9 1.0) (layers "B.Cu" "B.Paste" "B.Mask") (net 2 "/VBUS"))
		(pad "2" smd rect (at -0.8 0 180) (size 0.9 1.0) (layers "B.Cu" "B.Paste" "B.Mask") (net 3 "SIG"))
	)
	(footprint "Test:U2" (layer "F.Cu") (at 132 116 30)
		(property "Reference" "U2" (at 0 0 30) (layer "F.SilkS"))
		(pad "1" smd trapezoid (at -2 0 30) (size 1.0 1.2) (rect_delta 0 0.4) (layers "F.Cu") (net 3 "SIG"))
		(pad "2" smd chamfered_rect (at 0 0 30) (size 1.0 1.0) (chamfer_ratio 0.25) (chamfer top_left bottom_right) (layers "F.Cu") (net 3 "SIG"))
		(pad "3" smd oval (at 2 0 120) (size 0.6 1.4) (layers "F.Cu") (net 3 "SIG"))
		(pad "4" thru_hole rect (at 0 3 30) (size 1.6 1.6) (drill 0.8 (offset 0.2 0)) (layers "*.Cu") (net 3 "SIG"))
	)

	(segment (start 106 120) (end 116 120) (width 0.5) (layer "F.Cu") (net 2))
	(arc (start 116 120) (mid 117.414214 119.414214) (end 118 118) (width 0.5) (layer "F.Cu") (net 2))
	(segment (start 118 118) (end 118 106) (width 0.5) (layer "F.Cu") (net 2))
	(segment (start 118 106) (end 120 106) (width 0.5) (layer "F.Cu") (net 2))
	(via micro (at 118 112) (size 0.3) (drill 0.1) (layers "F.Cu" "In1.Cu") (net 2))
	(via micro (at 118 112) (size 0.3) (drill 0.1) (layers "In1.Cu" "In2.Cu") (net 2))
	(via blind (at 118 109) (size 0.5) (drill 0.25) (layers "F.Cu" "In2.Cu") (net 2))
	(segment (start 118 109) (end 118 112) (width 0.3) (layer "In2.Cu") (net 2))
	(segment (start 118 112) (end 114 112) (width 0.3) (layer "In2.Cu") (net 2))
	(via blind (at 114 112) (size 0.5) (drill 0.25) (layers "In2.Cu" "In3.Cu") (net 2))
	(segment (start 114 112) (end 114 116) (width 0.3) (layer "In3.Cu") (net 2))
	(via (at 114 116) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (remove_unused_layers yes) (keep_end_layers yes) (net 2))
	(segment (start 114 116) (end 113.2 124) (width 0.4) (layer "B.Cu") (net 2))

	(segment (start 122 105) (end 124 105) (width 0.4) (layer "F.Cu") (net 1))
	(via (at 124 105) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net 1))
	(segment (start 124 105) (end 110 105) (width 0.4) (layer "In4.Cu") (net 1))

	(segment (start 120 104) (end 126 104) (width 0.25) (layer "F.Cu") (net 3))
	(via micro (at 126 104) (size 0.3) (drill 0.1) (layers "F.Cu" "In1.Cu") (net 3))
	(segment (start 126 104) (end 126.6 104) (width 0.2) (layer "In1.Cu") (net 3))
	(via micro (at 126.6 104) (size 0.3) (drill 0.1) (layers "In1.Cu" "In2.Cu") (net 3))
	(segment (start 126.6 104) (end 126.6 110) (width 0.2) (layer "In2.Cu") (net 3))
	(gr_poly (pts (xy 126 110) (xy 128 110) (xy 128 112) (xy 126 112)) (stroke (width 0) (type solid)) (fill solid) (layer "In2.Cu") (net 3))

	(zone (net 1) (net_name "GND") (layer "In4.Cu") (hatch edge 0.5)
		(connect_pads yes (clearance 0.3)) (min_thickness 0.2) (filled_areas_thickness no)
		(fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5))
		(polygon (pts (xy 100 100) (xy 112 100) (xy 112 125) (xy 100 125)))
		(filled_polygon (layer "In4.Cu")
			(pts
				(xy 100 100) (xy 112 100) (xy 112 125) (xy 100 125)
				(xy 100 119.5) (xy 104.8 119.5) (xy 104.8 121.2) (xy 107.2 121.2) (xy 107.2 118.8) (xy 104.8 118.8) (xy 104.8 119.5) (xy 100 119.5)
				(xy 100 106) (xy 102 106) (xy 102 108) (xy 104 108) (xy 104 105) (xy 102 105) (xy 102 106) (xy 100 106)
			)
		)
	)
	(gr_rect (start 98 98) (end 136 128) (stroke (width 0.1) (type default)) (fill none) (layer "Edge.Cuts"))
)
